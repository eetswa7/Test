{
  "name": "breachline-benchmark-inbox",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "vars": {
    "BENCHMARK_ALLOWED_ORIGIN": "https://replace-with-the-exact-game-origin.invalid",
    "BENCHMARK_BRANCH": "main"
  },
  "durable_objects": {
    "bindings": [{"name":"BENCHMARK_INBOX","class_name":"BenchmarkInbox"}]
  },
  "migrations": [{"tag":"v1","new_sqlite_classes":["BenchmarkInbox"]}],
  "observability": {"enabled": false}
}
